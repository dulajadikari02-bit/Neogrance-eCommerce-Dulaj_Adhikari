PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=neogrance

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Default seeded admin login (see database/schema.sql) — change the password after first login
ADMIN_EMAIL=admin@neogrance.com

# Order status emails — SMTP details for your Hostinger business mailbox.
# hPanel: Emails -> your mailbox -> "Configure Email Client" shows these.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=neo@neogrance.com
SMTP_PASSWORD=
